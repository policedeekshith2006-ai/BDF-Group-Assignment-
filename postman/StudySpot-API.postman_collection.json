        {
          "name": "1. Book Carrel 4 to Asha",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Booking successfully created for Asha\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Booking created successfully\");",
                  "    pm.expect(jsonData.booking.student_id).to.eql(1);",
                  "    pm.expect(jsonData.booking.carrel_id).to.eql(4);",
                  "    pm.expect(jsonData.booking.status).to.eql(\"Active\");",
                  "    if (jsonData.booking && jsonData.booking.id) {",
                  "        pm.collectionVariables.set(\"asha_booking_id\", jsonData.booking.id.toString());",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": 1,\n  \"carrel_id\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "TEST 1: Books Carrel 4 to Asha (ID 1). Expected 201 Created."
          },
          "response": [
            {
              "name": "Test 1 Expected Success",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Booking created successfully\",\n  \"booking\": {\n    \"id\": 1,\n    \"student_id\": 1,\n    \"student_name\": \"Asha\",\n    \"carrel_id\": 4,\n    \"carrel_name\": \"Carrel 4\",\n    \"carrel_zone\": \"B\",\n    \"status\": \"Active\"\n  }\n}"
            }
          ]
        },
        {
          "name": "2. Attempt to book Carrel 4 to Ravi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Double booking rejected with exact error message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"Carrel 4 is already booked\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
