                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "TEST 2: Ravi attempts to book Carrel 4 while Asha is active. Expected 409 Conflict."
          },
          "response": [
            {
              "name": "Test 2 Expected Conflict",
              "status": "Conflict",
